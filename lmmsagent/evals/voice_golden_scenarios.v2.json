      "expected_command": "stop",
      "needs_confirmation": false
    },
    {
      "utterance": "hey lmms create a new project",
      "expected_intent": "project.new",
      "expected_command": "new project",
      "needs_confirmation": true
    },
    {
      "utterance": "hey lmms save the project as my song.mmp",
